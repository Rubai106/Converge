# CONVERGE — environment variables (example only; no real values here)
# Copy to .env when you need a real Switch server; never commit .env.

# Port for the CONVERGE app (default 3000)
PORT=3000

# Real Switch server base URL. Leave UNSET to run the labelled SIMULATED stub.
# Example for a local headless Switch stack: http://localhost:8000
SWITCH_BASE_URL=

# Real Switch agent API key (returned once by POST /agents). Never commit a real key.
SWITCH_API_KEY=

# Registration token for the Switch server (used once to register the agent).
# Generated by the Switch deployment; keep it in the Switch server's own .env.
AGENT_REGISTRATION_TOKEN=
